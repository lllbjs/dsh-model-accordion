{
  "name": "dsh-model-accordion",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Self-contained DSH plugin: collapses the model list by provider in the web GUI and bundles the WorkBuddy / Trae / Qoder / OpenCode connector host adapters (vendored) plus a unified connector settings hub, so models, login state and settings keep working even after the four original connector plugins are uninstalled.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendored",
    "install.sh",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-picker",
    "accordion",
    "collapsible",
    "provider",
    "connector"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT"
}
