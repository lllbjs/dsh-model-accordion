{
  "name": "dsh-model-accordion",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Collapse the model list by provider in the DSH web GUI: one clickable label per provider (composer menu and /model popup), with a per-row favorite star, favorites pinning, sorting, search passthrough and a stable menu height.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "install.sh",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-picker",
    "accordion",
    "collapsible",
    "provider"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT"
}
