{
  "name": "dsh-model-accordion",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Self-contained DSH plugin: collapses the model menu by provider (favorites, sorting, search passthrough, one-click model refresh) and bundles the WorkBuddy / Trae / OpenCode connector hosts (vendored), so models and sign-in keep working after the original connector plugins are uninstalled.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendored",
    "install.sh",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-picker",
    "accordion",
    "collapsible",
    "provider",
    "connector"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0",
    "yaml": ">=2.9.0 <3.0.0"
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT"
}
