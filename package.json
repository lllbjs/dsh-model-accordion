{
  "name": "dsh-model-accordion",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Self-contained DSH plugin: collapses the model list by provider and bundles the WorkBuddy / Trae / Qoder / OpenCode connector hosts (vendored), with a unified settings hub that shows account info and model lists, configures accounts (PAT / OAuth / switching), refreshes models and tests individual models — all working after the original four connector plugins are uninstalled.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendored",
    "install.sh",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-picker",
    "accordion",
    "collapsible",
    "provider",
    "connector"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0",
    "yaml": ">=2.9.0 <3.0.0"
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT"
}
